// Ejecuta docker build en el directorio del proyecto
//
// runDockerBuild(project_dir, tag) → exit code (0 = ok)

fn runDockerBuild(project_dir, tag) {
    out "[docker] construyendo imagen: " + tag

    unsafe{
        OS.exec("docker", ["--version"])
    }

    let result = unsafe{
        OS.exec("docker", ["build", "-t", tag, project_dir])
    }
    return result
}
